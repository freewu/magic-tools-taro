{
  "name": "magic-tools-taro",
  "version": "1.0.0",
  "private": true,
  "description": "一个常用工具应用合集（Taro + React + TypeScript 版）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "React"
  },
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:swan": "taro build --type swan --watch",
    "build:swan": "taro build --type swan",
    "dev:alipay": "taro build --type alipay --watch",
    "build:alipay": "taro build --type alipay",
    "dev:tt": "taro build --type tt --watch",
    "build:tt": "taro build --type tt",
    "dev:qq": "taro build --type qq --watch",
    "build:qq": "taro build --type qq",
    "dev:jd": "taro build --type jd --watch",
    "build:jd": "taro build --type jd",
    "dev:lark": "taro build --type lark --watch",
    "build:lark": "taro build --type lark",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "freewu",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.25.6",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-alipay": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-jd": "4.3.2",
    "@tarojs/plugin-platform-qq": "4.3.2",
    "@tarojs/plugin-platform-swan": "4.3.2",
    "@tarojs/plugin-platform-tt": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-react": "^7.24.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-platform-lark": "1.1.5",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.2",
    "postcss": "^8.4.47",
    "react-refresh": "^0.14.2",
    "sass": "^1.80.4",
    "typescript": "^5.6.3",
    "webpack": "5.91.0"
  }
}
