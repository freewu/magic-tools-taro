{
  "name": "magic-tools-taro",
  "version": "1.0.0",
  "private": true,
  "description": "一个常用工具应用合集（Taro + React + TypeScript 版）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "React"
  },
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:swan": "taro build --type swan --watch",
    "build:swan": "taro build --type swan",
    "dev:alipay": "taro build --type alipay --watch",
    "build:alipay": "taro build --type alipay",
    "dev:tt": "taro build --type tt --watch",
    "build:tt": "taro build --type tt",
    "dev:qq": "taro build --type qq --watch",
    "build:qq": "taro build --type qq",
    "dev:jd": "taro build --type jd --watch",
    "build:jd": "taro build --type jd",
    "dev:lark": "taro build --type lark --watch",
    "build:lark": "taro build --type lark",
    "dev:rn": "taro build --type rn --watch",
    "build:rn": "taro build --type rn",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "freewu",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.25.6",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-alipay": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-jd": "4.3.2",
    "@tarojs/plugin-platform-qq": "4.3.2",
    "@tarojs/plugin-platform-swan": "4.3.2",
    "@tarojs/plugin-platform-tt": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ant-design/react-native": "5.4.3",
    "@babel/core": "^7.25.2",
    "@babel/preset-react": "^7.24.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/metro-config": "0.73.5",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/stack": "6.4.1",
    "@tarojs/cli": "4.3.2",
    "@tarojs/components-rn": "4.3.2",
    "@tarojs/plugin-platform-lark": "1.1.5",
    "@tarojs/rn-runner": "4.3.2",
    "@tarojs/rn-supporter": "4.3.2",
    "@tarojs/runtime-rn": "4.3.2",
    "@tarojs/taro-rn": "4.3.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.2",
    "base64-js": "1.5.1",
    "expo": "~50.0.2",
    "postcss": "^8.4.47",
    "prop-types": "15.8.1",
    "react-native": "0.73.11",
    "react-native-device-info": "10.14.0",
    "react-native-gesture-handler": "2.14.1",
    "react-native-root-siblings": "5.0.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0",
    "react-native-svg": "14.2.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.80.4",
    "stylelint": "16.9.0",
    "typescript": "^5.6.3",
    "webpack": "5.91.0"
  }
}
